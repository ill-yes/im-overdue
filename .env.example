# Copy to .env, keep private (chmod 600 .env), and fill in both required values.
# Exact browser-facing URL, no path or trailing slash, e.g. http://192.168.1.20:4317
IM_OVERDUE_ORIGIN=
# 12-256 characters, at most 1024 UTF-8 bytes. Use a long unique password.
# Single-quote the value in .env to preserve literal $ and # characters.
IM_OVERDUE_PASSWORD=
IM_OVERDUE_PORT=4317
PUID=99
PGID=100
